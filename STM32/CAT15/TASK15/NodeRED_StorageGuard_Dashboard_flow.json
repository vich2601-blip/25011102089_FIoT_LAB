    {
        "id": "sg00000weatherFn",
        "type": "function",
        "z": "sg0000000000tab1",
        "name": "Chennai weather",
        "func": "// OpenWeatherMap -> Chennai outside weather\nconst w = msg.payload;\nif (!w || !w.main) { node.warn(\"Weather API error\"); return null; }\n\nflow.set('chennai', {\n    temp:  w.main.temp,\n    hum:   w.main.humidity,\n    press: w.main.pressure,\n    desc:  w.weather[0].description\n});\n\nreturn [\n    { payload: \"update\" },                                   // -> compare\n    { payload: w.main.temp,     topic: \"Chennai Temp (C)\" },  // -> chart\n    { payload: w.main.humidity, topic: \"Chennai Humidity (%)\" },\n    { payload: w.main.temp },                                 // -> Chennai gauges\n    { payload: w.main.humidity },\n    { payload: w.main.pressure },\n    { payload: w.weather[0].description }\n];",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 570,
        "y": 520,
        "wires": [
            [
                "sg00000compareFn"
            ],
            [
                "sg0000000000chart"
            ],
            [
                "sg0000000000chart"
            ],
            [
                "sg00000owmGaugeT"
            ],
            [
                "sg00000owmGaugeH"
            ],
            [
                "sg00000owmGaugeP"
            ],
            [
                "sg000000txtOutsd"
            ]
        ]
    },
    {
        "id": "sg00000compareFn",
        "type": "function",
        "z": "sg0000000000tab1",
        "name": "Compare",
        "func": "// Compare storage (BME280) with Chennai outside weather\nconst s = flow.get('storage');\nconst c = flow.get('chennai');\nif (!c) return null;\n\nif (!s) return null;\n\nconst dT = s.temp - c.temp;\nconst dH = s.hum - c.hum;\nconst sign = v => (v >= 0 ? \"+\" : \"\") + v.toFixed(1);\n\nconst tText = sign(dT) + \" \u00b0C (\" + (dT >= 0 ? \"storage warmer\" : \"storage cooler\") + \")\";\nconst hText = sign(dH) + \" % (\" + (dH >= 0 ? \"storage more humid\" : \"storage drier\") + \")\";\n\nlet verdict = \"Storage is close to outside conditions\";\nif (dT > 3)       verdict = \"Storage is hotter than outside - improve ventilation\";\nelse if (dT < -3) verdict = \"Storage is cooler than outside - good\";\nif (dH > 10)      verdict += \" | Too humid inside - check for leaks/dampness\";\n\nreturn [\n    { payload: tText },\n    { payload: hText },\n    { payload: verdict }\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 600,
        "wires": [
            [
                "sg000000txtDiffT"
            ],
            [
                "sg000000txtDiffH"
            ],
            [
                "sg000000txtVerdc"
            ]
        ]
    },
