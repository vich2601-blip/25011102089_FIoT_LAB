    {
        "id": "sg0000000splitfn",
        "type": "function",
        "z": "sg0000000000tab1",
        "name": "Split values",
        "func": "// Payload from STM32: {\"temp\":27.45,\"hum\":55.2,\"press\":1008.32,\"alarm\":0}\nconst d = msg.payload;\nif (typeof d !== 'object' || d.temp === undefined) return null;\n\nconst alarm = d.alarm ? 1 : 0;\nflow.set('storage', { temp: d.temp, hum: d.hum, press: d.press });\nconst status = alarm ? \"ALARM - check storage!\" : \"Normal\";\n\nreturn [\n    { payload: d.temp,  topic: \"Temperature (C)\" },\n    { payload: d.hum,   topic: \"Humidity (%)\" },\n    { payload: d.press.toFixed(2) + \" hPa\" },\n    { payload: status },\n    { payload: alarm },\n    { payload: new Date().toLocaleTimeString() },\n    { payload: \"update\" },         // -> compare\n    { payload: d.press }           // -> BME pressure gauge\n];",
        "outputs": 8,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 200,
        "wires": [
            [
                "sg000000gaugetmp",
                "sg0000000000chart",
                "sg00000bmeGaugeT"
            ],
