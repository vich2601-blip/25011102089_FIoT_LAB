        "type": "http request",
        "z": "sg0000000000tab1",
        "name": "OpenWeatherMap Chennai",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://api.openweathermap.org/data/2.5/weather?q=Chennai&appid=YOUR_OPENWEATHER_API_KEY&units=metric",
        "tls": "",
        "persist": false,
