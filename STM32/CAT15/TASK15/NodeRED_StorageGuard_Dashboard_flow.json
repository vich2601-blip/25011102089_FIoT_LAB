        "type": "function",
        "z": "sg0000000000tab1",
        "name": "Alarm turned on?",
        "func": "// Show a pop-up only when the alarm turns ON\nif (msg.payload === 1 && context.get('last') !== 1) {\n    context.set('last', 1);\n    return { payload: \"Storage alarm! Temperature or humidity is too high.\" };\n}\ncontext.set('last', msg.payload);\nreturn null;",
