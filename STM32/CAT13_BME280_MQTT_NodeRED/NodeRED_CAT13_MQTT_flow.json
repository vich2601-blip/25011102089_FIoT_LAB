  {
    "id": "c13stats",
    "type": "function",
    "z": "cat13flow",
    "name": "min / max / average",
    "func": "// CAT12/13 - running statistics of the BME280 readings\nif (msg.topic === \"reset\") {\n    context.set(\"stats\", {});\n    node.status({ fill: \"grey\", shape: \"ring\", text: \"reset\" });\n    return null;\n}\nconst d = msg.payload;\nif (!d || d.status !== \"success\") {\n    node.status({ fill: \"red\", shape: \"ring\", text: \"bad reading\" });\n    return null;\n}\nconst names = {\n    temperature: \"Temperature (°C)\",\n    humidity:    \"Humidity (%RH)\",\n    pressure:    \"Pressure (hPa)\"\n};\nconst s = context.get(\"stats\") || {};\nfor (const k of Object.keys(names)) {\n    const v = Number(d[k]);\n    if (!s[k]) s[k] = { min: v, max: v, sum: 0, n: 0 };\n    s[k].min = Math.min(s[k].min, v);\n    s[k].max = Math.max(s[k].max, v);\n    s[k].sum += v;\n    s[k].n   += 1;\n}\ncontext.set(\"stats\", s);\n\nconst rows = Object.keys(names).map(k => ({\n    parameter: names[k],\n    minimum:   +s[k].min.toFixed(2),\n    maximum:   +s[k].max.toFixed(2),\n    average:   +(s[k].sum / s[k].n).toFixed(2)\n}));\nlet table = \"Parameter            Minimum  Maximum  Average\\n\";\nfor (const r of rows) {\n    table += r.parameter.padEnd(20) + String(r.minimum).padStart(8) +\n             String(r.maximum).padStart(9) + String(r.average).padStart(9) + \"\\n\";\n}\nnode.status({ fill: \"green\", shape: \"dot\", text: s.temperature.n + \" samples\" });\nmsg.payload = rows;\nmsg.table = table;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 220,
    "wires": [
      [
        "c13table"
      ]
    ]
  },
