  {
    "id": "c13split",
    "type": "function",
    "z": "cat13flow",
    "name": "split T / H / P",
    "func": "// {\"status\":\"success\",\"temperature\":..,\"humidity\":..,\"pressure\":..} -> 3 messages\nconst d = msg.payload;\nif (typeof d !== \"object\" || d.status !== \"success\") {\n    node.status({ fill: \"red\", shape: \"ring\", text: \"invalid payload\" });\n    return null;\n}\nnode.status({ fill: \"green\", shape: \"dot\", text: d.temperature + \" °C  \" + d.humidity + \" %RH  \" + d.pressure + \" hPa\" });\nreturn [\n    { topic: \"temperature\", payload: d.temperature },\n    { topic: \"humidity\",    payload: d.humidity },\n    { topic: \"pressure\",    payload: d.pressure }\n];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 120,
    "wires": [
      [
        "c13t"
      ],
      [
        "c13h"
      ],
      [
        "c13p"
      ]
    ]
  },
