    "disabled": false,
    "hidden": false
  },
  {
    "id": "c13uigrp",
    "type": "ui_group",
    "name": "Live readings",
    "tab": "c13uitab",
    "order": 1,
    "disp": true,
    "width": "12",
    "collapse": false,
    "className": ""
  },
  {
    "id": "c13din",
    "type": "mqtt in",
    "z": "cat13dash",
    "name": "vishrudh/stm32/bme280",
    "topic": "vishrudh/stm32/bme280",
    "qos": "0",
    "datatype": "json",
    "broker": "c13broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 160,
    "wires": [
      [
        "c13dsplit"
      ]
    ]
  },
  {
    "id": "c13dsplit",
    "type": "function",
    "z": "cat13dash",
    "name": "split T / H / P",
    "func": "// {\"status\":\"success\",\"temperature\":..,\"humidity\":..,\"pressure\":..} -> 3 messages\nconst d = msg.payload;\nif (typeof d !== \"object\" || d.status !== \"success\") {\n    node.status({ fill: \"red\", shape: \"ring\", text: \"invalid payload\" });\n    return null;\n}\nnode.status({ fill: \"green\", shape: \"dot\", text: d.temperature + \" °C  \" + d.humidity + \" %RH  \" + d.pressure + \" hPa\" });\nreturn [\n    { topic: \"temperature\", payload: d.temperature },\n    { topic: \"humidity\",    payload: d.humidity },\n    { topic: \"pressure\",    payload: d.pressure }\n];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 160,
    "wires": [
      [
        "c13gt",
        "c13chart"
      ],
      [
        "c13gh",
        "c13chart"
      ],
      [
        "c13gp"
      ]
    ]
  },
  {
